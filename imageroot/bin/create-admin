#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later
set -euo pipefail
if [[ $# != 1 || ! -t 0 ]]; then
    echo "Usage (interactive): create-admin email@example.org" >&2
    exit 2
fi
podman exec -it central-app odk-cmd --email "$1" user-create
podman exec central-app odk-cmd --email "$1" user-promote
