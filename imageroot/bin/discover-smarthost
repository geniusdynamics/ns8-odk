#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
import json
import os
from pathlib import Path

import agent

smtp = agent.get_smarthost_settings(agent.redis_connect(use_replica=True))
options = {}
if smtp["enabled"]:
    encryption = smtp["encrypt_smtp"]
    options = {
        "host": smtp["host"],
        "port": smtp["port"],
        "secure": encryption == "tls",
        "ignoreTLS": encryption == "none",
        "requireTLS": encryption == "starttls",
        "tls": {"rejectUnauthorized": smtp["tls_verify"]},
        "auth": {"user": smtp["username"], "pass": smtp["password"]} if smtp["username"] else None,
    }

# Podman reads the JSON literally from the env file. The configuration library
# merges it over Central's defaults without interpolating SMTP credentials.
os.umask(0o077)
target = Path("odk-smarthost.env")
temporary = target.with_suffix(".tmp")
temporary.write_text("NODE_CONFIG=" + json.dumps({"default": {"email": {"transportOpts": options}}}) + "\n")
temporary.replace(target)
