#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
import os
import secrets
from pathlib import Path

os.umask(0o077)
state = Path(os.environ["AGENT_STATE_DIR"])
keys = state / "odk-secrets"
keys.mkdir(exist_ok=True)
for name, length in (("enketo-secret", 64), ("enketo-less-secret", 32), ("enketo-api-key", 128)):
    target = keys / name
    if not target.exists():
        temporary = target.with_suffix(".tmp")
        temporary.write_text(secrets.token_hex(length // 2))
        temporary.replace(target)

target = state / "postgres.env"
if not target.exists():
    password = secrets.token_hex(32)
    temporary = target.with_suffix(".tmp")
    temporary.write_text(f"POSTGRES_PASSWORD={password}\nPGPASSWORD={password}\n")
    temporary.replace(target)
