[Unit]
Description=ODK Central postgresql
BindsTo=odk.service
PartOf=odk.service
After=odk.service

[Service]
Type=notify
NotifyAccess=all
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%E/state/environment
WorkingDirectory=%E/state
Restart=on-failure
TimeoutStartSec=240
TimeoutStopSec=75
ExecStart=/usr/bin/podman run --replace --name postgresql-app --pod odk --sdnotify=conmon --cgroups=no-conmon \
    --env-file=%E/state/postgres.env --env POSTGRES_USER=odk --env POSTGRES_DB=odk \
    --volume odk-postgres:/var/lib/postgresql/data:Z \
    ${POSTGRES_IMAGE} -c listen_addresses=127.0.0.1
ExecStartPost=/usr/bin/timeout 90 /usr/bin/bash -c 'until podman exec postgresql-app pg_isready -h 127.0.0.1 -U odk -d odk; do sleep 2; done'
ExecStop=/usr/bin/podman stop --ignore -t 15 postgresql-app
ExecStopPost=/usr/bin/podman rm --ignore -f postgresql-app
