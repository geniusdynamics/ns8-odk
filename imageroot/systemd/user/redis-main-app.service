[Unit]
Description=ODK Central redis-main
BindsTo=odk.service
PartOf=odk.service
After=odk.service

[Service]
Type=notify
NotifyAccess=all
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%E/state/environment
WorkingDirectory=%E/state
Restart=on-failure
TimeoutStartSec=240
TimeoutStopSec=75
ExecStart=/usr/bin/podman run --replace --name redis-main-app --pod odk --sdnotify=conmon --cgroups=no-conmon \
    --volume odk-redis-main:/data:Z \
    ${REDIS_IMAGE} redis-server --bind 127.0.0.1 --port 6379 --appendonly yes
ExecStop=/usr/bin/podman stop --ignore -t 15 redis-main-app
ExecStopPost=/usr/bin/podman rm --ignore -f redis-main-app
