[Unit]
Description=ODK Central pyxform
BindsTo=odk.service
PartOf=odk.service
After=odk.service

[Service]
Type=notify
NotifyAccess=all
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%E/state/environment
WorkingDirectory=%E/state
Restart=on-failure
TimeoutStartSec=240
TimeoutStopSec=75
ExecStart=/usr/bin/podman run --replace --name pyxform-app --pod odk --sdnotify=conmon --cgroups=no-conmon \
    ${PYXFORM_HTTP_IMAGE} gunicorn --bind 127.0.0.1:8081 --workers 2 --timeout 600 --max-requests 1 --max-requests-jitter 3 main:app()
ExecStop=/usr/bin/podman stop --ignore -t 15 pyxform-app
ExecStopPost=/usr/bin/podman rm --ignore -f pyxform-app
