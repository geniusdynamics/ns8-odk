[Unit]
Description=ODK Central enketo
BindsTo=odk.service
PartOf=odk.service
After=odk.service redis-main-app.service redis-cache-app.service

[Service]
Type=notify
NotifyAccess=all
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%E/state/environment
WorkingDirectory=%E/state
Restart=on-failure
TimeoutStartSec=240
TimeoutStopSec=75
ExecStart=/usr/bin/podman run --replace --name enketo-app --pod odk --sdnotify=conmon --cgroups=no-conmon \
    --env-file=%E/state/odk.env --env-file=%E/etc/central.env \
    --volume %E/state/odk-secrets:/etc/secrets:ro,z \
    ${ODK_ENKETO_IMAGE}
ExecStop=/usr/bin/podman stop --ignore -t 15 enketo-app
ExecStopPost=/usr/bin/podman rm --ignore -f enketo-app
