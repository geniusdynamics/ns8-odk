{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://nethserver.org/json-schema/task/output/odk/get-configuration",
  "title": "Read ODK Central settings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "host",
    "sysadmin_email",
    "lets_encrypt"
  ],
  "properties": {
    "host": {
      "type": "string"
    },
    "sysadmin_email": {
      "type": "string"
    },
    "lets_encrypt": {
      "type": "boolean",
      "description": "Request a Let's Encrypt TLS certificate"
    }
  }
}
