import json
import os
import sys

import agent

host = os.environ.get("TRAEFIK_HOST", "")
route = agent.get_route(os.environ["MODULE_ID"]) if host else {}
json.dump({
    "host": host,
    "sysadmin_email": os.environ.get("ODK_SYSADMIN_EMAIL", ""),
    "lets_encrypt": route.get("lets_encrypt", False),
}, sys.stdout)
