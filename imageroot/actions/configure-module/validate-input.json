{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://nethserver.org/json-schema/task/input/odk/configure-module",
  "title": "Configure ODK Central",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "host",
    "sysadmin_email"
  ],
  "properties": {
    "host": {
      "type": "string",
      "format": "hostname",
      "pattern": "^[a-zA-Z0-9.-]+\\.[a-zA-Z0-9-]+$"
    },
    "sysadmin_email": {
      "type": "string",
      "format": "email",
      "pattern": "^[A-Za-z0-9._+%-]+@[A-Za-z0-9.-]+\\.[A-Za-z0-9-]+$"
    },
    "lets_encrypt": {
      "type": "boolean",
      "description": "Request a Let's Encrypt TLS certificate"
    }
  }
}
