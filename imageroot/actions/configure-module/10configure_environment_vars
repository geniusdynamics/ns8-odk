import json
import os
import sys
from pathlib import Path

import agent

data = json.load(sys.stdin)
host = data["host"].lower()
email = data["sysadmin_email"]
state = Path(os.environ["AGENT_STATE_DIR"])
target = state / "odk.env"
temporary = target.with_suffix(".tmp")
temporary.write_text(f"DOMAIN={host}\nSYSADMIN_EMAIL={email}\nEMAIL_FROM=no-reply@{host}\n")
temporary.replace(target)
agent.set_env("TRAEFIK_HOST", host)
agent.set_env("ODK_SYSADMIN_EMAIL", email)
agent.dump_env()
